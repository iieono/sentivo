# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# imported design reference (dev only)
design/

# FCM / Firebase secrets — never commit
google-services.json
*service-account*.json
fcm-*.json

# local native module build artifacts
modules/*/android/build/
modules/*/android/.cxx/
